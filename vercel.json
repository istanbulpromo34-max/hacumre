{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "cache-control", "value": "public, max-age=300, s-maxage=1800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/hat-tablolari", "destination": "/index.html" }
  ]
}
